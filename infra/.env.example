# =====================================================================
# Variáveis da stack do VPS. Copie para infra/.env e preencha.
#
# infra/.env NUNCA entra no git — já está coberto pelo .gitignore.
#
# TODOS os valores abaixo são gerados ou escolhidos POR VOCÊ. Não peça a
# ninguém que os gere por você em um chat, e não cole os valores
# preenchidos de volta numa conversa: JWT_SECRET e SERVICE_ROLE_KEY dão
# acesso total ao banco, por cima de qualquer política RLS.
# =====================================================================

# ---------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------
# Senha do Postgres. Gere com:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# JWT — o segredo que assina e confere TODAS as sessões
#
# Mínimo de 32 caracteres. Gere com:  openssl rand -base64 48
#
# Trocar este valor depois invalida toda sessão ativa E as duas chaves
# abaixo, que são JWTs assinados com ele.
# ---------------------------------------------------------------------
JWT_SECRET=

# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com o JWT_SECRET acima.
# Gere os dois no gerador oficial do Supabase para auto-hospedagem
# (https://supabase.com/docs/guides/self-hosting#api-keys), colando o seu
# JWT_SECRET, com os papéis "anon" e "service_role".
#
# ANON_KEY é pública — vai para o navegador, é o que o RLS espera ver.
# SERVICE_ROLE_KEY IGNORA RLS. Ela só existe no servidor; se vazar, vaza a
# base inteira. Nunca sob prefixo NEXT_PUBLIC_.
ANON_KEY=
SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Endereço público
#
# Origem única servida pelo Traefik, com TLS. É o valor que vai tanto em
# NEXT_PUBLIC_SUPABASE_URL (no build da imagem) quanto aqui.
# ---------------------------------------------------------------------
SITE_URL=https://app.seudominio.com.br

# ---------------------------------------------------------------------
# Imagem do app
#
# Construída pelo GitHub Actions e publicada no GHCR. Prefira a tag do
# commit (sha-xxxxxxx) em vez de :latest — assim dá para voltar à versão
# anterior trocando uma linha.
# ---------------------------------------------------------------------
APP_IMAGE=ghcr.io/yannhayafugi/brid-system:latest

# ---------------------------------------------------------------------
# Integrações
# ---------------------------------------------------------------------
# Usada pelo módulo de análise de Termo de Referência.
ANTHROPIC_API_KEY=
