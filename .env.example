# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commitar .env.local (já está no .gitignore).

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta — só usada no servidor (API routes), nunca no navegador
SUPABASE_SECRET_KEY=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# --- Importação de arquivos grandes (só no VPS; ver docs/SADA-ARQUIVOS-GRANDES.md)
# Conexão direta ao Postgres, para gravar por COPY. Sem ela a carga usa a API
# do Supabase e fica muito mais lenta.
SADA_DB_URL=
# Pasta onde o arquivo enviado fica durante a leitura (padrão: pasta temporária).
SADA_UPLOAD_DIR=
